OPENAI_API_KEY=
OPENAI_BASE_URL=
NEUROTOKEN_LLM_PROXY=
NEUROTOKEN_MODEL=openai:gpt-latest
NEUROTOKEN_DEFAULT_CONFIG=agent_pipeline/configs/camcan_meg_h5.toml
NEUROTOKEN_PIPELINE_PYTHON=python
NEUROTOKEN_TMUX_SOCKET=${HOME}/.local/state/neurotoken-runtime/tmux/neurotoken.sock
NEUROTOKEN_ALLOWED_INPUT_ROOTS=
NEUROTOKEN_ALLOWED_OUTPUT_ROOTS=./outputs
NEUROTOKEN_CODING_MODEL=composer-2.5
NEUROTOKEN_CURSOR_PYTHON=python
NEUROTOKEN_CURSOR_TIMEOUT_SECONDS=300
NEUROTOKEN_ADAPTER_TASK_REGISTRY=
NEUROTOKEN_ADAPTER_WORKTREE_ROOT=/tmp/neurotoken-adapter-worktrees
CURSOR_API_KEY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
